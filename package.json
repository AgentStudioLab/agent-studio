  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch sidecar/src/server.ts --port=4123 --token=dev-token --db=sidecar/dev.db",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:sidecar": "bun run scripts/build-sidecar.ts",
